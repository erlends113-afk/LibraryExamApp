@model IEnumerable<LibraryExamApp.Models.Entities.Author>
@{ ViewData["Title"] = "Autori"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>✍️ Autoru saraksts (CRUD)</h2>
    <a asp-action="Create" class="btn btn-primary">+ Pievienot autoru</a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Kļūda!</strong> @TempData["ErrorMessage"]
    </div>
}

<table class="table table-bordered table-striped shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Vārds, Uzvārds</th>
            <th>E-pasts</th>
            <th>Dzimšanas datums</th>
            <th>Grāmatu skaits</th>
            <th class="text-center" style="width: 180px;">Darbības</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-bold">@item.FullName</td>
                <td>@item.Email</td>
                <td>@item.BirthDate.ToString("yyyy-MM-dd")</td>
                <td><span class="badge bg-info text-dark">@item.Books.Count grāmatas</span></td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Labot</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Dzēst</a>
                </td>
            </tr>
        }
    </tbody>
</table>