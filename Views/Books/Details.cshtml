@model LibraryExamApp.Models.Entities.Book
@{ ViewData["Title"] = "Grāmatas detaļas"; }

<h2>📖 Grāmatas informācija</h2>
<hr />

<div class="card p-4 shadow-sm col-md-8">
    <dl class="row">
        <dt class="col-sm-3">Nosaukums:</dt>
        <dd class="col-sm-9 fw-bold">@Model.Title</dd>

        <dt class="col-sm-3">ISBN:</dt>
        <dd class="col-sm-9"><code>@Model.ISBN</code></dd>

        <dt class="col-sm-3">Autors:</dt>
        <dd class="col-sm-9">@Model.Author?.FullName (@Model.Author?.Email)</dd>

        <dt class="col-sm-3">Kategorija:</dt>
        <dd class="col-sm-9">@Model.Category?.Title</dd>

        <dt class="col-sm-3">Izdošanas gads:</dt>
        <dd class="col-sm-9">@Model.PublishYear</dd>

        <dt class="col-sm-3">Cena:</dt>
        <dd class="col-sm-9 text-success fw-bold">@Model.Price.ToString("C")</dd>
    </dl>

    <h5 class="mt-3">Aizņēmumu vēsture šai grāmatai:</h5>
    @if (Model.Loans.Any())
    {
        <ul class="list-group">
            @foreach (var loan in Model.Loans)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Lasītājs: @loan.Member?.FullName (Termiņš: @loan.DueDate.ToString("yyyy-MM-dd"))
                    <span class="badge @(loan.IsReturned ? "bg-success" : "bg-warning text-dark")">
                        @(loan.IsReturned ? "Nodota" : "Aktīvs aizņēmums")
                    </span>
                </li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted">Šī grāmata vēl ne reizi nav tikusi aizņemta.</p>
    }
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Labot</a>
    <a asp-action="Index" class="btn btn-secondary">Atpakaļ uz sarakstu</a>
</div>