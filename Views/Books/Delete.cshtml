@model LibraryExamApp.Models.Entities.Book
@{
    ViewData["Title"] = "Dzēst grāmatu";
}

<h2 class="text-danger">Vai tiešām vēlaties dzēst šo grāmatu?</h2>
<div class="alert alert-warning">
    Uzmanību: Izdzēšot grāmatu, kaskādē tiks dzēsti arī visi ar to saistītie aizņēmumi!
</div>

<div class="card p-3 col-md-6 shadow-sm">
    <dl class="row mb-0">
        <dt class="col-sm-4">Nosaukums:</dt>
        <dd class="col-sm-8 fw-bold">@Model.Title</dd>

        <dt class="col-sm-4">Autors:</dt>
        <dd class="col-sm-8">@Model.Author?.FullName</dd>

        <dt class="col-sm-4">Cena:</dt>
        <dd class="col-sm-8">@Model.Price.ToString("C")</dd>
    </dl>
</div>

<form asp-action="Delete" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Jā, izdzēst</button>
    <a asp-action="Index" class="btn btn-secondary">Atcelt</a>
</form>