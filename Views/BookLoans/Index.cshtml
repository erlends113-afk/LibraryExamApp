@model IEnumerable<LibraryExamApp.Models.Entities.BookLoan>
@{ ViewData["Title"] = "Aizņēmumi"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>🔄 Aizņēmumu saraksts (CRUD)</h2>
    <a asp-action="Create" class="btn btn-primary">+ Reģistrēt aizņēmumu</a>
</div>

<table class="table table-bordered table-striped shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Grāmata</th>
            <th>Lasītājs</th>
            <th>Paņemts</th>
            <th>Termiņš</th>
            <th>Statuss</th>
            <th>Sods</th>
            <th class="text-center">Darbības</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var l in Model)
        {
            <tr>
                <td class="fw-bold">@l.Book?.Title</td>
                <td>@l.Member?.FullName</td>
                <td>@l.LoanDate.ToString("yyyy-MM-dd")</td>
                <td>@l.DueDate.ToString("yyyy-MM-dd")</td>
                <td>
                    @if (l.IsReturned) { <span class="badge bg-success">Nodota</span> }
                    else { <span class="badge bg-warning text-dark">Aktīvs</span> }
                </td>
                <td class="text-danger">@l.FineAmount.ToString("C")</td>
                <td class="text-center">
                    <a asp-action="Edit" asp-route-id="@l.Id" class="btn btn-sm btn-outline-warning">Labot</a>
                    <a asp-action="Delete" asp-route-id="@l.Id" class="btn btn-sm btn-outline-danger">Dzēst</a>
                </td>
            </tr>
        }
    </tbody>
</table>